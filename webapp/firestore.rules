rules_version = '2';

// Firestore Security Rules for YDKE user backups.
//
// One document per user at /users/{uid}, where {uid} is the Firebase Auth
// UID (path segment compared directly to request.auth.uid below). Written
// exclusively by the native Windows app (windows/src/YDKE.Windows/
// FirestoreSyncService): only two fields, an opaque `backup` string and an
// `updatedAtMs` integer -- see isValidBackup. The retired web app no longer
// writes to this collection.
//
// Deploy with the Firebase CLI from this repo:
//   firebase login
//   firebase use udsp-9fedc          (matches .firebaserc)
//   firebase deploy --only firestore:rules
// ...or paste this file's contents into
//   Firebase Console -> Firestore Database -> Rules -> Publish
//
// This does NOT require the Admin SDK / service-account key at all -- that
// credential is only for privileged server-side operations that bypass
// these rules entirely. Normal per-user profile create/read/update/delete
// should always go through the Firebase CLIENT SDK + these rules instead.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidBackup();
      allow delete: if isOwner(userId);
    }

    // Deny anything not explicitly matched above (defense in depth).
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidBackup() {
      // Only the exact two fields FirestoreSyncService.SaveBackupAsync writes;
      // rejects any other shape.
      let data = request.resource.data;
      return data.keys().hasOnly(['backup', 'updatedAtMs'])
        && data.backup is string
        && data.updatedAtMs is int;
    }
  }
}
