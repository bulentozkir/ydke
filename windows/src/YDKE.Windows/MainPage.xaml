<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YDKE_Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <Grid>
        <NavigationView
            x:Name="Navigation"
            HorizontalContentAlignment="Stretch"
            IsBackButtonVisible="Collapsed"
            CompactPaneLength="56"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            SelectionChanged="OnNavigationSelectionChanged"
            OpenPaneLength="238"
            PaneDisplayMode="LeftCompact">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Tag="home"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="CardsItem" Tag="cards"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8C4;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="QuizItem" Tag="quiz"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="WordsItem" Tag="words"><NavigationViewItem.Icon><FontIcon Glyph="&#xE82D;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="SimpleGamesItem" Tag="simple-games"><NavigationViewItem.Icon><FontIcon Glyph="&#xE768;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="ComplexGamesItem" Tag="complex-games"><NavigationViewItem.Icon><FontIcon Glyph="&#xEA86;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="StatsItem" Tag="stats"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="ProfileItem" Tag="profile"><NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="HelpItem" Tag="help"><NavigationViewItem.Icon><FontIcon Glyph="&#xE897;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="AboutItem" Tag="about"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="QuickSettingsBar"
                    Grid.Row="0"
                    Padding="28,10,28,10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="QuickSettingsGrid" ColumnSpacing="10" RowSpacing="10">
                            <ComboBox
                                x:Name="QuickUiLanguage"
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="NativeName"
                                SelectedValuePath="Code"
                                SelectionChanged="OnQuickUiLanguageChanged" />
                            <ComboBox
                                x:Name="QuickStudyLanguage"
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="NativeName"
                                SelectedValuePath="Code"
                                SelectionChanged="OnQuickStudyLanguageChanged" />
                            <ComboBox
                                x:Name="QuickLevel"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnQuickLevelChanged" />
                        </Grid>
                        <FontIcon
                            x:Name="CloudStatusIcon"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Glyph="&#xE753;" />
                    </Grid>
                </Border>

                <ScrollViewer
                    x:Name="ContentScroll"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Auto"
                    SizeChanged="OnContentScrollSizeChanged"
                    VerticalAlignment="Stretch"
                    VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="ContentHost" HorizontalAlignment="Stretch" Padding="20,16,20,28">
                        <StackPanel
                            x:Name="PageContent"
                            MaxWidth="1080"
                            HorizontalAlignment="Left"
                            Spacing="12" />
                    </Grid>
                </ScrollViewer>

                <ProgressRing
                    x:Name="LoadingRing"
                    Grid.Row="1"
                    Width="44"
                    Height="44"
                    IsActive="False"
                    Visibility="Collapsed" />

                <InfoBar
                    x:Name="Notice"
                    Grid.Row="1"
                    Margin="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsClosable="True"
                    IsOpen="False"
                    MaxWidth="460" />
            </Grid>
        </NavigationView>
    </Grid>
</Page>
