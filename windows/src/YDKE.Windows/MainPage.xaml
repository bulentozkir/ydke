<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YDKE_Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    PreviewKeyDown="OnStudyKeyDown"
    mc:Ignorable="d">

    <Grid>
        <NavigationView
            x:Name="Navigation"
            AutomationProperties.AutomationId="shell.Navigation"
            HorizontalContentAlignment="Stretch"
            IsBackButtonVisible="Collapsed"
            CompactPaneLength="56"
            IsPaneOpen="False"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            SelectionChanged="OnNavigationSelectionChanged"
            OpenPaneLength="238"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="1280"
            PaneDisplayMode="Auto">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Tag="home"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="CardsItem" Tag="cards"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8C4;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="QuizItem" Tag="quiz"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="WordsItem" Tag="words"><NavigationViewItem.Icon><FontIcon Glyph="&#xE82D;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="SimpleGamesItem" Tag="simple-games"><NavigationViewItem.Icon><FontIcon Glyph="&#xE768;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="ComplexGamesItem" Tag="complex-games"><NavigationViewItem.Icon><FontIcon Glyph="&#xEA86;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="StatsItem" Tag="stats"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="ProfileItem" Tag="profile"><NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="HelpItem" Tag="help"><NavigationViewItem.Icon><FontIcon Glyph="&#xE897;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="AboutItem" Tag="about"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="QuickSettingsBar"
                    Grid.Row="0"
                    Padding="28,10,28,10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="QuickSettingsGrid" ColumnSpacing="10" RowSpacing="10">
                            <ComboBox
                                x:Name="QuickUiLanguage"
                                AutomationProperties.AutomationId="shell.AppLanguage"
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="NativeName"
                                SelectedValuePath="Code"
                                SelectionChanged="OnQuickUiLanguageChanged" />
                            <ComboBox
                                x:Name="QuickStudyLanguage"
                                AutomationProperties.AutomationId="shell.StudyLanguage"
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="NativeName"
                                SelectedValuePath="Code"
                                SelectionChanged="OnQuickStudyLanguageChanged" />
                            <ComboBox
                                x:Name="QuickLevel"
                                AutomationProperties.AutomationId="shell.Level"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnQuickLevelChanged" />
                        </Grid>
                        <Button
                            x:Name="WindowModeButton"
                            AutomationProperties.AutomationId="shell.WindowMode"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            MinWidth="96"
                            MinHeight="64"
                            MaxWidth="160"
                            Padding="10,8"
                            Click="OnWindowModeButtonClick">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="WindowModeIcon" FontSize="22"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="WindowModeText" Grid.Column="1" FontSize="18"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="LocalStatusButton"
                            AutomationProperties.AutomationId="cloud.AccountToggle"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            MinWidth="64"
                            MinHeight="64"
                            MaxWidth="144"
                            Padding="8,6"
                            Background="Transparent"
                            BorderThickness="0"
                            IsEnabled="False"
                            Click="OnLocalStatusButtonClick">
                            <StackPanel Spacing="4">
                                <Border x:Name="LocalStatusBadge" Width="32" Height="32" CornerRadius="16"
                                        BorderThickness="1" HorizontalAlignment="Center">
                                    <FontIcon x:Name="LocalStatusIcon" FontSize="18" Glyph="&#xE77B;"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="LocalStatusText" FontSize="18" TextWrapping="Wrap" TextAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer
                    x:Name="ContentScroll"
                    AutomationProperties.AutomationId="shell.ContentScroll"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    SizeChanged="OnContentScrollSizeChanged"
                    VerticalAlignment="Stretch"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    ZoomMode="Disabled">
                    <Grid x:Name="ContentHost" HorizontalAlignment="Stretch" Padding="20,16,20,28">
                        <ContentControl
                            x:Name="PageBounds"
                            AutomationProperties.AutomationId="shell.PageContent"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Stretch"
                            VerticalAlignment="Top">
                            <StackPanel
                                x:Name="PageContent"
                                MaxWidth="1080"
                                HorizontalAlignment="Left"
                                SizeChanged="OnPageContentSizeChanged"
                                Spacing="8" />
                        </ContentControl>
                    </Grid>
                </ScrollViewer>

                <ProgressRing
                    x:Name="LoadingRing"
                    Grid.Row="1"
                    Width="44"
                    Height="44"
                    IsActive="False"
                    Visibility="Collapsed" />

                <InfoBar
                    x:Name="Notice"
                    AutomationProperties.AutomationId="shell.Notice"
                    AutomationProperties.LiveSetting="Polite"
                    Grid.Row="2"
                    Margin="16,0,16,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    IsClosable="True"
                    IsOpen="False" />
            </Grid>
        </NavigationView>
    </Grid>
</Page>
