<local:ChromeWindow x:Class="TopWords.Windows.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TopWords.Windows"
                    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                    Title="Top Words — Trainer"
                    Icon="Assets/app.ico"
                    Background="{StaticResource SurfaceBrush}"
                    TextOptions.TextFormattingMode="Display"
                    UseLayoutRounding="True"
                    WindowStartupLocation="CenterScreen">

  <Border x:Name="Root" Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource HairlineBrush}"
          Margin="{Binding ChromeInset, RelativeSource={RelativeSource AncestorType=local:ChromeWindow}}">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
          <!-- A hairline outline separates the window from whatever is behind it, but
               a maximised window has no "behind" along its own edges and the line just
               eats a pixel of content. -->
          <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
            <Setter Property="BorderThickness" Value="0" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="{StaticResource CaptionHeightGridLength}" />
        <RowDefinition Height="2" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ============ Caption ============
           Drag, double-click-to-maximise and the system menu all come from WindowChrome
           reporting this strip as non-client area. Only the buttons opt back into hit
           testing, via WindowChrome.IsHitTestVisibleInChrome in their styles. -->
      <Grid Grid.Row="0" Background="{StaticResource ChromeBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0">
          <Image Source="Assets/logo.png" Width="18" Height="18"
                 VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="Top Words" Style="{StaticResource CaptionTitleStyle}" Margin="9,0,0,0" />
        </StackPanel>

        <!-- The site is a multi-page app with no chrome of its own, so history and
             reload have to live somewhere. Icon-only keeps the caption quiet; the
             tooltips carry the keyboard equivalents WebView2 already handles itself. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
          <Border Width="1" Margin="0,11" Background="{StaticResource HairlineBrush}" />

          <Button x:Name="BackButton" Style="{StaticResource ToolButtonStyle}"
                  Content="&#xE72B;" ToolTip="Geri (Alt+Sol)" IsEnabled="False"
                  Margin="10,0,0,0" Click="OnBackClick" />
          <Button x:Name="ForwardButton" Style="{StaticResource ToolButtonStyle}"
                  Content="&#xE72A;" ToolTip="İleri (Alt+Sağ)" IsEnabled="False"
                  Click="OnForwardClick" />
          <Button x:Name="ReloadButton" Style="{StaticResource ToolButtonStyle}"
                  Content="&#xE72C;" ToolTip="Yenile (F5)" IsEnabled="False"
                  Click="OnReloadClick" />
          <Button x:Name="HomeButton" Style="{StaticResource ToolButtonStyle}"
                  Content="&#xE80F;" ToolTip="Başlangıç sayfası" IsEnabled="False"
                  Click="OnHomeClick" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"
                  ToolTip="Simge durumuna küçült" Click="OnMinimizeClick" />

          <Button Click="OnMaximizeClick">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                <Setter Property="Content" Value="&#xE922;" />
                <Setter Property="ToolTip" Value="Ekranı kapla" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;" />
                    <Setter Property="ToolTip" Value="Önceki boyuta getir" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>

          <Button Style="{StaticResource CloseButtonStyle}" Content="&#xE8BB;"
                  ToolTip="Kapat" Click="OnCloseClick" />
        </StackPanel>
      </Grid>

      <ProgressBar x:Name="Progress" Grid.Row="1"
                   Style="{StaticResource NavigationProgressStyle}"
                   Visibility="Collapsed" />

      <!-- ============ Content ============ -->
      <Grid Grid.Row="2">
        <!-- Hidden rather than Collapsed: the control has to stay in layout for the WPF
             host to build its CoreWebView2, but a hosted child HWND always paints over
             WPF content, so the splash below could never be seen while it is on screen. -->
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#0F172A" Visibility="Hidden" />

        <Grid x:Name="Splash" Background="{StaticResource SurfaceBrush}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="Assets/logo.png" Width="96" Height="96"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,0.5">
              <Image.Effect>
                <DropShadowEffect Color="#6366F1" BlurRadius="48" ShadowDepth="0" Opacity="0.5" />
              </Image.Effect>
              <Image.RenderTransform>
                <ScaleTransform x:Name="SplashLogoScale" ScaleX="0.94" ScaleY="0.94" />
              </Image.RenderTransform>
            </Image>

            <Border x:Name="SplashTrack" Width="180" Height="3" CornerRadius="2" Margin="0,30,0,0"
                    Background="#16202F" ClipToBounds="True" HorizontalAlignment="Center">
              <Border Width="70" Height="3" CornerRadius="2" HorizontalAlignment="Left"
                      Background="{StaticResource BrandGradientBrush}">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="SplashSweep" X="-78" />
                </Border.RenderTransform>
              </Border>
            </Border>

            <TextBlock x:Name="SplashStatus" Text="Yükleniyor…"
                       Style="{StaticResource CaptionSubtitleStyle}"
                       HorizontalAlignment="Center" Margin="0,16,0,0" />
          </StackPanel>

          <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="SplashSweep"
                                   Storyboard.TargetProperty="X"
                                   From="-78" To="180" Duration="0:0:1.2"
                                   RepeatBehavior="Forever" />
                  <DoubleAnimation Storyboard.TargetName="SplashLogoScale"
                                   Storyboard.TargetProperty="ScaleX"
                                   From="0.94" To="1" Duration="0:0:0.55">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="SplashLogoScale"
                                   Storyboard.TargetProperty="ScaleY"
                                   From="0.94" To="1" Duration="0:0:0.55">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Grid.Triggers>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</local:ChromeWindow>
