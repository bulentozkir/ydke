<!--
  Design tokens and control styles for the packaged Windows host.

  The palette is taken from the product mark (windows/assets/source/icon.svg) and
  the web app's own theme colour, so the native chrome and the WebView2 content
  read as one surface rather than a dark page inside a light window:

    indigo #6366F1 -> #818CF8 -> cyan #22D3EE   brand gradient
    slate  #0F172A                              surface / <meta name="theme-color">

  Glyphs come from Segoe Fluent Icons (Windows 11) with Segoe MDL2 Assets as the
  fallback (Windows 10). WPF resolves comma-separated families left to right, so a
  single declaration covers both without a runtime OS check.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- ===================== Palette ===================== -->

  <Color x:Key="SurfaceColor">#0F172A</Color>
  <Color x:Key="ChromeColor">#0F172A</Color>
  <Color x:Key="HoverColor">#1E293B</Color>
  <Color x:Key="PressedColor">#334155</Color>
  <Color x:Key="HairlineColor">#1E293B</Color>
  <Color x:Key="CloseHoverColor">#C42B1C</Color>
  <Color x:Key="ClosePressedColor">#B0271A</Color>

  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
  <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
  <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
  <SolidColorBrush x:Key="CloseHoverBrush" Color="{StaticResource CloseHoverColor}" />
  <SolidColorBrush x:Key="ClosePressedBrush" Color="{StaticResource ClosePressedColor}" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="#475569" />

  <SolidColorBrush x:Key="AccentBrush" Color="#818CF8" />

  <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#6366F1" />
    <GradientStop Offset="0.55" Color="#818CF8" />
    <GradientStop Offset="1" Color="#22D3EE" />
  </LinearGradientBrush>

  <!-- ===================== Metrics ===================== -->

  <sys:Double x:Key="CaptionHeight">40</sys:Double>
  <GridLength x:Key="CaptionHeightGridLength">40</GridLength>

  <Style x:Key="KeyboardFocusVisualStyle">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="2"
                  BorderBrush="{StaticResource AccentBrush}"
                  BorderThickness="2"
                  CornerRadius="4" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Base text ===================== -->

  <Style x:Key="CaptionTitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="CaptionSubtitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- ===================== Toolbar buttons ===================== -->
  <!--
    Ghost buttons: no chrome at rest, a slate wash on hover. Disabled state is
    genuinely important here - back/forward spend most of their life disabled and
    a button that looks clickable but is not is worse than no button at all.
  -->
  <Style x:Key="ToolButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg"
                  Background="{TemplateBinding Background}"
                  CornerRadius="6"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bg" Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RecoveryButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="132" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RecoveryPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RecoveryButtonStyle}">
    <Setter Property="Background" Value="{StaticResource BrandGradientBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- ===================== Caption buttons ===================== -->
  <!--
    Sized 46x40 to match the system caption buttons, so the app does not read as
    slightly-off when placed beside a native window. Square corners, full bleed to
    the top-right corner - rounding these would expose the window background at the
    corner once DWM rounds the frame.
  -->
  <Style x:Key="CaptionButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="{StaticResource CaptionHeight}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource CloseHoverBrush}" />
              <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource ClosePressedBrush}" />
              <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Navigation progress ===================== -->
  <!--
    A 2px hairline under the caption. Replaces the old behaviour where the only
    feedback that a navigation was in flight was the page not changing.
  -->
  <Style x:Key="NavigationProgressStyle" TargetType="ProgressBar">
    <Setter Property="Height" Value="2" />
    <Setter Property="Foreground" Value="{StaticResource BrandGradientBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border Background="{TemplateBinding Foreground}" Opacity="0.8" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
