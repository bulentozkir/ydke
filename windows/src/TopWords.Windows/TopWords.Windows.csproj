<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <RootNamespace>TopWords.Windows</RootNamespace>
    <AssemblyName>TopWords</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64;x86;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.0.0</Version>
    <Product>Top Words — Trainer</Product>
    <Company>Top Words</Company>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TopWords.SelfTest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Injected into every document before page scripts run.
         Shared verbatim with the Linux/macOS hosts — see shared/bootstrap.js and
         linux/02-packaging-strategy.md §4. Link keeps the manifest resource name
         at TopWords.Windows.Scripts.bootstrap.js regardless of where the file lives. -->
    <EmbeddedResource Include="..\..\..\shared\bootstrap.js" Link="Scripts\bootstrap.js" />
    <EmbeddedResource Include="Assets\offline.html" />
    <Resource Include="Assets\app.ico" />

    <!-- The splash mark. Linked from the shared web asset set rather than copied so
         the caption icon, the launcher tile and the PWA manifest cannot drift apart.
         192px is the smallest source that stays crisp at the 96px splash size on a
         200% display. -->
    <Resource Include="..\..\assets\web\icon-192.png" Link="Assets\logo.png" />
  </ItemGroup>

  <!-- Bundled web app lives at repo-root webapp/ (moved from the retired udsp
       repo). Mirrored next to the exe so MainWindow's
       SetVirtualHostNameToFolderMapping can find it, and so package.ps1 and
       release.ps1 pick it up automatically since both publish straight into
       the MSIX/MSI staging directory. -->
  <Target Name="CopyWebApp" AfterTargets="Build;Publish">
    <ItemGroup>
      <WebAppFiles Include="$(MSBuildProjectDirectory)\..\..\..\webapp\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebAppFiles)"
          DestinationFolder="$(OutDir)webapp\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'$(OutDir)' != ''" />
    <Copy SourceFiles="@(WebAppFiles)"
          DestinationFolder="$(PublishDir)webapp\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
  </Target>

</Project>
