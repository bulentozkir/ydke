<?xml version="1.0" encoding="utf-8"?>

<!--
  MSIX manifest for the packaged desktop build.

  BLOCKER W2: the three REPLACE_ values below come from Partner Center and must be
  copied verbatim AFTER reserving the app name. Generating a package before the
  reservation exists is the single most common cause of submission rejection, and
  the Publisher value is a GUID-form distinguished name that cannot be guessed.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="REPLACE_PACKAGE_IDENTITY_NAME"
    Publisher="CN=REPLACE_PUBLISHER_GUID"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Top Words — Trainer</DisplayName>
    <PublisherDisplayName>REPLACE_PUBLISHER_DISPLAY_NAME</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="tr-TR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="TopWords" Executable="TopWords.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Top Words — Trainer"
        Description="İngilizce, Almanca, Fransızca, İtalyanca, İspanyolca, Portekizce ve Hollandaca kelime ezberleme uygulaması."
        BackgroundColor="#0F172A"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">

        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          ShortName="Top Words">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>

        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0F172A" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Win32 desktop app hosted in MSIX. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
