<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)NuGet.Config</RestoreConfigFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/YDKE.Windows/Models.cs" Link="Core/Models.cs" />
    <Compile Include="../../src/YDKE.Windows/LearningEngine.cs" Link="Core/LearningEngine.cs" />
    <Compile Include="../../src/YDKE.Windows/AppStorage.cs" Link="Core/AppStorage.cs" />
  </ItemGroup>
</Project>