<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/YDKE.Windows/AppDataPaths.cs" Link="Core/AppDataPaths.cs" />
    <Compile Include="../../src/YDKE.Windows/CloudConfig.cs" Link="Core/CloudConfig.cs" />
    <Compile Include="../../src/YDKE.Windows/CloudCredentials.cs" Link="Core/CloudCredentials.cs" />
    <Compile Include="../../src/YDKE.Windows/CloudCredentialStore.cs" Link="Core/CloudCredentialStore.cs" />
    <Compile Include="../../src/YDKE.Windows/GoogleAuthService.cs" Link="Core/GoogleAuthService.cs" />
    <Compile Include="../../src/YDKE.Windows/GoogleBrowserLauncher.cs" Link="Core/GoogleBrowserLauncher.cs" />
    <Compile Include="../../src/YDKE.Windows/GoogleBrowserSignIn.cs" Link="Core/GoogleBrowserSignIn.cs" />
    <Compile Include="../../src/YDKE.Windows/GoogleSignInPage.cs" Link="Core/GoogleSignInPage.cs" />
    <Compile Include="../../src/YDKE.Windows/FirebaseAuthService.cs" Link="Core/FirebaseAuthService.cs" />
    <Compile Include="../../src/YDKE.Windows/FirestoreSyncService.cs" Link="Core/FirestoreSyncService.cs" />
    <Compile Include="../../src/YDKE.Windows/Models.cs" Link="Core/Models.cs" />
    <Compile Include="../../src/YDKE.Windows/LearningEngine.cs" Link="Core/LearningEngine.cs" />
    <Compile Include="../../src/YDKE.Windows/AppStorage.cs" Link="Core/AppStorage.cs" />
    <Compile Include="../../src/YDKE.Windows/CloudSyncCoordinator.cs" Link="Core/CloudSyncCoordinator.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only CloudCredentialStore.cs needs a real package: DPAPI is not part of the shared framework. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="4.7.0" />
  </ItemGroup>
</Project>
